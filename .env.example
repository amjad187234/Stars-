# SMTP-Zugangsdaten für das Kontaktformular (z. B. E-Mail-Konto bei Hostinger).
# Diese Datei ist nur ein Vorlage – echte Werte gehören in .env.local (lokal)
# bzw. in die Umgebungsvariablen der Hosting-Plattform (niemals ins Git-Repo).

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@starseventsaal.de
SMTP_PASS=

# Empfänger der Kontaktanfragen (optional, Standard = SMTP_USER)
CONTACT_TO_EMAIL=info@starseventsaal.de
